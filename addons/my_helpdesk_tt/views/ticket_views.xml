<odoo>
    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">my_helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assigned_to"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">my_helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_name"/>
                        <field name="email"/>
                        <field name="priority"/>
                        <field name="state"/>
                        <field name="assigned_to"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">my_helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_root" name="My Helpdesk"/>
    <menuitem id="menu_helpdesk_ticket" name="Tickets"
              parent="menu_helpdesk_root"
              action="action_helpdesk_ticket"/>
</odoo>
